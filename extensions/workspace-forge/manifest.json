{
  "manifest_version": 3,
  "name": "Metallic Workspace Forge",
  "version": "0.2.0",
  "description": "Save, restore, group, and manage project-based Chrome workspaces.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Workspace Forge",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-workspace-forge": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Metallic Workspace Forge"
    }
  }
}
